# Copy to .env and fill in. Used by `npm run dev`, `npm start`, and docker compose.

# Required: password for /admin
ADMIN_PASSWORD=change-me
# Recommended: keeps admin sessions valid across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Fallback sign-up URL shown on the countdown screen. Usually set in /admin → Screen settings instead.
PUBLIC_URL=
# Set to 1 when running behind a reverse proxy (nginx, Caddy, Traefik, ...)
TRUST_PROXY=

# Bind address and port. With docker compose, PORT is the host port to publish.
HOST=0.0.0.0
PORT=4000
# SQLite file. Ignored by docker compose, which stores it in the lightning-data volume.
DATABASE_PATH=./data/lightning.db
